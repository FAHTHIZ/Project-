{
  "format": "victus.project",
  "version": 1,
  "name": "Special Ops",
  "startup_scene": "scenes/menu.vscene",
  "template": "3d",
  "engine_version": "0.2.0",
  "save_version": 1,
  "default_locale": "en",
  "window": {
    "width": 1600,
    "height": 720,
    "vsync": true
  },
  "rendering": {
    "quality": "high"
  },
  "input": {
    "actions": [
      {
        "name": "move_x",
        "positive": [
          "D",
          "Right",
          "Pad.LeftX+"
        ],
        "negative": [
          "A",
          "Left",
          "Pad.LeftX-"
        ],
        "dead_zone": 0.18
      },
      {
        "name": "move_y",
        "positive": [
          "W",
          "Up",
          "Pad.LeftY-"
        ],
        "negative": [
          "S",
          "Down",
          "Pad.LeftY+"
        ],
        "dead_zone": 0.18
      },
      {
        "name": "look_x",
        "positive": [
          "Pad.RightX+"
        ],
        "negative": [
          "Pad.RightX-"
        ],
        "dead_zone": 0.18
      },
      {
        "name": "look_y",
        "positive": [
          "Pad.RightY-"
        ],
        "negative": [
          "Pad.RightY+"
        ],
        "dead_zone": 0.18
      },
      {
        "name": "fire",
        "bindings": [
          "Mouse0",
          "Pad.RightTrigger"
        ]
      },
      {
        "name": "aim",
        "bindings": [
          "Mouse1",
          "Pad.LeftTrigger"
        ]
      },
      {
        "name": "reload",
        "bindings": [
          "R",
          "Pad.West"
        ]
      },
      {
        "name": "switch",
        "bindings": [
          "Q",
          "Pad.North"
        ]
      },
      {
        "name": "weapon1",
        "bindings": [
          "1"
        ]
      },
      {
        "name": "weapon2",
        "bindings": [
          "2"
        ]
      },
      {
        "name": "interact",
        "bindings": [
          "E",
          "F",
          "Pad.East"
        ]
      },
      {
        "name": "tool",
        "bindings": [
          "T",
          "Pad.DpadUp"
        ]
      },
      {
        "name": "jump",
        "bindings": [
          "Space",
          "Pad.South"
        ]
      },
      {
        "name": "sprint",
        "bindings": [
          "LeftShift",
          "Pad.LeftStick"
        ]
      },
      {
        "name": "crouch",
        "bindings": [
          "C",
          "LeftCtrl",
          "Pad.RightStick"
        ]
      },
      {
        "name": "pause",
        "bindings": [
          "Escape",
          "P",
          "Pad.Start"
        ]
      },
      {
        "name": "objectives",
        "bindings": [
          "Tab",
          "Pad.Back"
        ]
      },
      {
        "name": "diagnostics",
        "bindings": [
          "F3",
          "Pad.DpadDown"
        ]
      },
      {
        "name": "skip",
        "bindings": [
          "Space",
          "Enter",
          "Pad.South",
          "Pad.East"
        ]
      },
      {
        "name": "quick_save",
        "bindings": [
          "F5"
        ]
      },
      {
        "name": "quick_load",
        "bindings": [
          "F9"
        ]
      },
      {
        "name": "menu_up",
        "bindings": [
          "Up",
          "Pad.DpadUp"
        ]
      },
      {
        "name": "menu_down",
        "bindings": [
          "Down",
          "Pad.DpadDown"
        ]
      }
    ]
  }
}
