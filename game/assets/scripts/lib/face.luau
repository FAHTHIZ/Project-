-- Facial performance for the human cast: blinks, emotions, eye direction and lip sync.
-- The head mesh (generated by tools/characters/build_humans.py) has the morph targets
--   Blink JawOpen Smile Frown BrowUp BrowDown MouthO LookL LookR LookUp LookDown
-- Morphing runs on the CPU and re-uploads only when weights change, so weights are written only
-- when they move by more than a small step, and faces far from the camera are frozen.
local Face = {}
Face.__index = Face

local EMOTIONS = {
    neutral = {},
    smile = { Smile = 0.65, BrowUp = 0.15 },
    concern = { Frown = 0.35, BrowUp = 0.5 },
    focus = { BrowDown = 0.55, Frown = 0.1 },
    surprise = { BrowUp = 1.0, JawOpen = 0.12 },
    deadpan = { BrowDown = 0.18, Smile = 0.12 },
    -- under fire: brows knit and down, lips pressed (a little Frown), a slight squint
    strain = { BrowDown = 0.7, Frown = 0.3, Blink = 0.12 },
    fear = { BrowUp = 0.75, Frown = 0.4, JawOpen = 0.08 },
    anger = { BrowDown = 0.9, Frown = 0.55 },
}
Face.EMOTIONS = EMOTIONS
local TARGETS = { "Blink", "JawOpen", "Smile", "Frown", "BrowUp", "BrowDown", "MouthO", "LookL", "LookR", "LookUp", "LookDown" }

-- Small deterministic generator so each face blinks on its own rhythm.
local Rng = {}
Rng.__index = Rng
function Rng.new(seed) return setmetatable({ s = (seed * 2654435761) % 4294967296 }, Rng) end
function Rng:NextNumber()
    self.s = (self.s * 1103515245 + 12345) % 2147483648
    return self.s / 2147483648
end
Face.Rng = Rng

local function find_head(e)
    for _, c in e:children() do
        if string.sub(c.name, -5) == "_Head" then
            local ok, names = pcall(function() return c:morph_targets() end)
            if ok and names and #names > 0 then return c end
        end
        local f = find_head(c)
        if f then return f end
    end
    return nil
end

local function find_named(e, name)
    for _, c in e:children() do
        if c.name == name then return c end
        local f = find_named(c, name)
        if f then return f end
    end
    return nil
end
Face.find_named = find_named

-- body: the character model entity (root of the skeleton). seed: deterministic blink timing.
function Face.new(body, seed)
    local self = setmetatable({}, Face)
    self.body = body
    self.mesh = find_head(body)
    self.head_bone = find_named(body, "Head")
    self.w = {}
    self.cur = {}
    for _, n in TARGETS do self.w[n] = 0; self.cur[n] = 0 end
    self.emotion = "neutral"
    self.emotion_hold = 0
    self.rng = Rng.new(seed or 1)
    self.blink_t = 1 + self.rng:NextNumber() * 3
    self.blink = 0
    self.saccade_t = 0.5
    self.sx, self.sy = 0, 0
    self.line = nil
    self.line_t = 0
    -- body state the owner feeds in every frame (Face:set_state): exertion 0..1 (hard running,
    -- breathing through the mouth), stress 0..1 (in a fight: knit brows, faster blinking),
    -- aim 0..1 (sighting: the eyes narrow)
    self.exert, self.stress, self.aiming = 0, 0, 0
    self.breath_t = (seed or 1) % 7
    self.flinch_t = 0
    self.flinches = 0
    self.active = self.mesh ~= nil
    self.find_tries = 30 -- the head mesh may resolve a few frames after start
    return self
end

function Face:set_emotion(name, seconds)
    if EMOTIONS[name] then
        self.emotion = name
        self.emotion_hold = seconds or 4
    end
end

function Face:set_state(exert, stress, aiming)
    self.exert, self.stress, self.aiming = exert or 0, stress or 0, aiming or 0
end

-- Startle reflex (a shot close by, a hit): a hard blink, brows up and the jaw sets for ~0.45 s.
-- Repeated startles habituate: within 1.5 s of the last one nothing new shows, and a run of them
-- (a long firefight) fades toward a third of the first reaction.
function Face:flinch(strength)
    local now = time.now()
    local since = now - (self.flinch_at or -99)
    if since < 1.5 then return end
    self.habit = math.max(0, (self.habit or 0) * math.exp(-since / 12)) + 1
    self.flinch_at = now
    self.flinch_t = 0.45
    self.flinch_k = math.clamp(strength or 1, 0.2, 1) * math.max(0.35, 1 / self.habit)
    self.blink = 0.14
    self.flinches += 1
end

-- line: an entry of scripts/lib/voice_data (or nil to stop). t: seconds into the line.
function Face:speak(line)
    self.line = line
    self.line_t = 0
    if line and line.e then self:set_emotion(line.e, line.d + 1.5) end
end

local function frame_value(str, i)
    local c = string.byte(str, i)
    if not c then return 0 end
    return (c - 48) / 9
end

-- look: world point the eyes should rest on (nil = straight ahead); yaw: the body's yaw (deg).
function Face:update(dt, look, yaw, cam_pos)
    -- distance cull first: faces beyond 22 m are not animated, and an unresolved head mesh is
    -- not searched for until the actor is close (the search touches morph-target data, which can
    -- be expensive while a character's mesh is still being prepared)
    if cam_pos and self.head_bone then
        local d = vector.magnitude(self.head_bone.world_position - cam_pos)
        if d > 22 then return end
    end
    if not self.active then
        if self.find_tries <= 0 then return end
        self.find_wait = (self.find_wait or 0) - dt
        if self.find_wait > 0 then return end
        self.find_wait = 0.5
        self.find_tries -= 1
        self.mesh = find_head(self.body)
        self.active = self.mesh ~= nil
        if not self.active then return end
    end
    local w = self.w
    for _, n in TARGETS do w[n] = 0 end
    -- emotion
    if self.emotion_hold > 0 then
        self.emotion_hold -= dt
        if self.emotion_hold <= 0 then self.emotion = "neutral" end
    end
    for k, v in EMOTIONS[self.emotion] do w[k] = v end
    -- a fight shows on the face whatever the scripted mood was: blend toward strain
    local st = self.stress
    if st > 0.01 and self.emotion ~= "strain" and self.emotion ~= "fear" then
        for k, v in EMOTIONS.strain do w[k] = math.max(w[k] * (1 - st * 0.5), v * st) end
    end
    -- sighting narrows the eyes a touch
    if self.aiming > 0.5 then w.Blink = math.max(w.Blink, 0.18 * self.aiming) end
    -- hard breathing after running: the mouth opens on each breath
    if self.exert > 0.05 then
        self.breath_t += dt * (1.1 + self.exert * 1.2)
        local b = 0.5 + 0.5 * math.sin(self.breath_t * math.pi * 2)
        w.JawOpen = math.max(w.JawOpen, self.exert * (0.08 + 0.14 * b))
    end
    if self.flinch_t > 0 then
        self.flinch_t -= dt
        local f = math.sin(math.clamp(self.flinch_t / 0.45, 0, 1) * math.pi) * (self.flinch_k or 1)
        w.BrowUp = math.max(w.BrowUp, 0.8 * f)
        w.Frown = math.max(w.Frown, 0.45 * f)
        w.BrowDown *= 1 - f
    end
    -- blink (stress roughly doubles the rate)
    self.blink_t -= dt * (1 + st)
    if self.blink_t <= 0 then
        self.blink = 0.14
        self.blink_t = 2.0 + self.rng:NextNumber() * 3.5
        if self.rng:NextNumber() < 0.15 then self.blink_t = 0.25 end -- occasional double blink
    end
    if self.blink > 0 then
        self.blink -= dt
        w.Blink = math.max(w.Blink, math.sin(math.clamp(self.blink / 0.14, 0, 1) * math.pi))
    end
    -- lip sync from the line's per-frame data
    if self.line then
        self.line_t += dt
        local l = self.line
        if self.line_t >= l.d then
            self.line = nil
        else
            local i = math.floor(self.line_t * 30) + 1
            local j = frame_value(l.j, i)
            local jn = frame_value(l.j, i + 1)
            local f = self.line_t * 30 - (i - 1)
            local jaw = j + (jn - j) * f
            -- syllable texture: the envelope is smooth, so modulate it a little
            jaw *= 0.8 + 0.2 * math.sin(self.line_t * 31)
            local shape = string.sub(l.m, i, i)
            w.JawOpen = math.max(w.JawOpen, jaw * 0.8)
            if shape == "o" then
                w.MouthO = jaw * 0.75
                w.Smile *= 0.3
            elseif shape == "e" then
                w.Smile = math.max(w.Smile, jaw * 0.35)
            end
        end
    end
    -- eyes: lead the head toward the look point, plus small saccades
    self.saccade_t -= dt
    if self.saccade_t <= 0 then
        self.saccade_t = 0.6 + self.rng:NextNumber() * 1.6
        self.sx = (self.rng:NextNumber() - 0.5) * 0.3
        self.sy = (self.rng:NextNumber() - 0.5) * 0.2
    end
    local ex, ey = self.sx, self.sy
    if look and self.head_bone then
        local hp = self.head_bone.world_position
        local d = look - hp
        local want = math.deg(math.atan2(d.x, d.z))
        local rel = ((want - (yaw or 0)) + 540) % 360 - 180
        -- the head IK turns up to 65 degrees; the eyes take what is left plus a lead
        if self.last_rel and math.abs(rel - self.last_rel) > 40 and self.blink <= 0 then self.blink = 0.14 end
        self.last_rel = rel
        local rest = rel - math.clamp(rel, -65, 65) * 0.8
        ex += math.clamp(rest / 25, -1, 1)
        local flat = math.sqrt(d.x * d.x + d.z * d.z)
        local pitch = math.deg(math.atan2(d.y, flat))
        ey += math.clamp(pitch / 30, -1, 1) * 0.6
    end
    if ex > 0 then w.LookL = math.min(1, ex) else w.LookR = math.min(1, -ex) end
    if ey > 0 then w.LookUp = math.min(1, ey) else w.LookDown = math.min(1, -ey) end
    -- smooth and write only meaningful changes
    local k = 1 - math.exp(-dt * 22)
    for _, n in TARGETS do
        local target = w[n]
        local c = self.cur[n]
        local nv = (n == "Blink") and target or (c + (target - c) * k)
        if math.abs(nv - c) > 0.015 or (target == 0 and c ~= 0 and math.abs(nv) < 0.015) then
            if target == 0 and math.abs(nv) < 0.015 then nv = 0 end
            self.cur[n] = nv
            self.mesh:set_morph_weight(n, nv)
        end
    end
end

return Face
