-- Autotest plans for the Kestrel Valley open world (scenes/tests/world_*.vscene, generated by
-- tools/world/world_scene.py from scenes/world/kestrel.vscene). Each viewpoint plan places the
-- player at a designed vantage point, turns the view to the composition target and checks that
-- the player stands on the terrain, that streamed cells around the player have loaded, and that
-- the far canopy is resident. Screenshots for docs/evidence/world_*.png are taken from the same
-- scenes (tools/test/shot.sh).
local Game = require("scripts/lib/game")
local Views = require("scripts/tests/world_views")

local V = vector.create
local P = {}

local function ps() return Game.player_state end

local function look_at(p)
    local s = ps()
    local cp = s.cam.world_position
    local d = p - cp
    s.yaw = math.deg(math.atan2(-d.x, -d.z))
    s.pitch = math.deg(math.atan2(d.y, math.sqrt(d.x * d.x + d.z * d.z)))
end

local function trees_near(p, r)
    local n = 0
    for _, e in scene.tagged("Tree") do
        local q = e.world_position
        local dx, dz = q.x - p.x, q.z - p.z
        if dx * dx + dz * dz < r * r then n += 1 end
    end
    return n
end

local function ground_checks(c, name, v)
    local p = Game.player.world_position
    local h = terrain.height(p.x, p.z)
    c.check(name .. " terrain", h ~= nil, string.format("pos %.1f %.1f %.1f", p.x, p.y, p.z))
    if h then
        c.check(name .. " grounded", math.abs(p.y - h) < 0.35 and Game.player.grounded ~= false,
            string.format("player y %.2f terrain %.2f", p.y, h))
    end
    local s = terrain.sample(p.x, p.z)
    if s then
        local w = s.weights
        c.check(name .. " splat", math.abs(w[1] + w[2] + w[3] + w[4] - 1) < 0.05,
            string.format("w %.2f %.2f %.2f %.2f", w[1], w[2], w[3], w[4]))
    end
    local n = trees_near(p, 60)
    c.check(name .. " streamed", n >= math.floor(v.trees60 * 0.9),
        string.format("trees within 60 m %d (scene has %d)", n, v.trees60))
    local wc = Game.world_canopy
    local cn = wc and wc.blocks or 0
    c.check(name .. " canopy", cn == Views.canopy_blocks, string.format("blocks %d/%d", cn, Views.canopy_blocks))
    if wc then
        -- the proxy of the player's own cell must be hidden once its detailed trees are in
        local key = math.floor(p.x / 64) .. "_" .. math.floor(p.z / 64)
        local b = wc.near[key]
        c.check(name .. " canopy swap", (b == nil) or (not b.shown and wc.hidden > 0),
            string.format("cell %s hidden %d of %d", key, wc.hidden, wc.near_count))
    end
end

for name, v in Views.views do
    P[name] = {
        { at = 0.3, run = function() look_at(V(v.look[1], v.look[2], v.look[3])) end },
        { at = 6.0, run = function(c) ground_checks(c, name, v) end },
        { at = 25 },
    }
end

-- Walk the first stretch of the Op01 trail from the turnout: the trail must be walkable terrain
-- (no snags on props, no falling through) and cells must keep streaming around the player.
P.world_trail_walk = {
    { at = 0.3, run = function(c)
        c.data.start = Game.player.world_position
        local t = Views.trail_probe
        look_at(V(t[1], c.data.start.y + 1.6, t[2]))
    end },
    { at = 0.6, move = V(0, 1, 0) },
    { at = 1.5, run = function()
        local t = Views.trail_probe
        local p = Game.player.world_position
        look_at(V(t[1], p.y + 1.6, t[2]))
    end },
    { at = 9.6, move = false, run = function(c)
        local p = Game.player.world_position
        local d = p - c.data.start
        local moved = math.sqrt(d.x * d.x + d.z * d.z)
        c.check("trail walk distance", moved > 25, string.format("moved %.1f m", moved))
        local h = terrain.height(p.x, p.z) or -1000
        c.check("trail walk grounded", math.abs(p.y - h) < 0.4, string.format("y %.2f terrain %.2f", p.y, h))
        c.check("trail walk streamed", trees_near(p, 50) > 0, string.format("trees near %d", trees_near(p, 50)))
    end },
    { at = 12 },
}

-- The Op01 search line (scenes/tests/op01_line*.vscene, the Op01 chapter with the driver). Three
-- contractors walk a line east -> west across the trail below the cabin once the player nears the
-- footbridge. op01_line: crouched, light off and still at 22-32 m, the line passes, the team holds
-- and says so. op01_line_loud: standing in its path with the light on, the line finds the player,
-- the team calls it and puts it down. The player is unhittable in both.
local Dialogue = require("scripts/lib/dialogue")
local Squad = require("scripts/lib/squad")
local function line_setup(pos, look)
    return { at = 0.3, run = function(c)
        c.data.hurt = Game.hurt_player
        Game.hurt_player = function() return false end
        c.data.ev = {}
        for _, ev in { "line_start", "line_loud", "line_passed" } do
            Game.on(ev, function() c.data.ev[ev] = time.now() end)
        end
        local m = Game.mission
        c.check("mission", m ~= nil, "")
        if not m then return end
        m:enter("trail")
        local p = V(pos[1], (terrain.height(pos[1], pos[2]) or 0) + 0.05, pos[2])
        local d = V(look[1], 0, look[2]) - p
        local yaw = math.deg(math.atan2(-d.x, -d.z))
        m:place_player(p, yaw)
        m:place_squad(p, yaw)
    end }
end
local function line_said(id)
    for _, l in Dialogue.state().log do if l.id == id then return true end end
    return false
end
local function line_ctls()
    local out = {}
    for _, r in Squad.state().enemies do
        if r.entity.valid and r.ctl and r.ctl.group == "line" then table.insert(out, r.ctl) end
    end
    return out
end
P.op01_line = {
    line_setup({ 8, 204 }, { 40, 172 }),
    { at = 0.6, press = "crouch" }, { at = 0.7, release = "crouch" },
    { at = 0.9, press = "light" }, { at = 1.0, release = "light" },
    { at = 160, run = function(c)
        local ps = Game.player_state
        c.check("line_started", c.data.ev.line_start ~= nil, "")
        c.check("stayed_hidden", c.data.ev.line_loud == nil and not c.data.engaged,
            "loud " .. tostring(c.data.ev.line_loud) .. " max aware " .. string.format("%.2f", c.data.max_aware or 0))
        c.check("line_passed", c.data.ev.line_passed ~= nil, "")
        c.check("team_called_it", line_said("op1_line_02") and line_said("op1_line_05"), "")
        local gone = 0
        for _, e in line_ctls() do if e.dormant then gone += 1 end end
        c.check("line_gone", gone == 3, gone .. " stowed")
        c.check("overheard", c.data.chat == true, "")
        c.check("still_low_dark", ps.crouched and not ps.torch_on, "crouched " .. tostring(ps.crouched) .. " torch " .. tostring(ps.torch_on))
        Game.hurt_player = c.data.hurt
    end },
}
P.op01_line_loud = {
    line_setup({ 30, 185 }, { 70, 175 }),
    { at = 110, run = function(c)
        c.check("line_started", c.data.ev.line_start ~= nil, "")
        c.check("line_loud", c.data.ev.line_loud ~= nil, "")
        c.check("team_called_it", line_said("op1_line_08"), "")
        local down = 0
        for _, e in line_ctls() do if e.down then down += 1 end end
        c.check("line_fought", down >= 1, down .. " down")
        c.check("no_quiet_ending", c.data.ev.line_passed == nil, "")
        Game.hurt_player = c.data.hurt
    end },
}
for _, pe in { { P.op01_line, 159 }, { P.op01_line_loud, 109 } } do
    local plan = pe[1]
    for i = 0, math.floor((pe[2] - 1.2) / 0.3) do
        table.insert(plan, { at = 1.2 + i * 0.3, run = function(c)
            local mx = c.data.max_aware or 0
            for _, e in line_ctls() do
                if not e.down then
                    mx = math.max(mx, e.aware or 0)
                    if e.state == "engage" then c.data.engaged = true end
                end
            end
            c.data.max_aware = mx
            for _, l in Dialogue.state().log do if string.find(l.id, "grey_line_") then c.data.chat = true end end
        end })
    end
    table.sort(plan, function(a, b) return a.at < b.at end)
end

return P
